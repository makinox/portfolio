---
import Icon, { IconCatalog } from "@/components/Icon";
import { globalClasses } from "@/constants";
import { cn } from "@/utils";

interface Props {
    bookList: Array<{
        title: string;
        url: string;
    }>;
}

const { bookList } = Astro.props;
---

<section class={cn(globalClasses.container, "mt-40")} id="talks">
    <h2 class={cn(globalClasses.blackGradient, "text-4xl font-bold mb-12")}>
        Books
    </h2>
    <div class={cn(globalClasses.itemsGrid, "gap-2")}>
        {bookList.map((element) => (
            <a class="badge p-4 shadow-md" target="_blank" href={element.url}>
                <span>{element.title}</span>
                <Icon className="w-3 h-3 text-info" icon={IconCatalog.right} />
            </a>
        ))}
    </div>
</section>
